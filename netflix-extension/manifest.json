{
  "manifest_version": 3,
  "name": "Netflix Dual Subtitles 雙語字幕",
  "_comment_version": "⚠ 每次修改程式碼都必須調整下方 version 版本號 / Bump the version below on every code change (reload won't pick up changes otherwise)",
  "version": "1.5.0",
  "description": "Show English subtitles alongside your selected language on Netflix / 在 Netflix 同時顯示英文與所選語言字幕",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "Netflix Dual Subtitles"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
